  "info": {
    "_postman_id": "a895c4e3-63cb-4beb-b7ae-d34345527392",
    "name": "University of Alberta Research Data (Borealis Dataverse) Info Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Scoped OpenAPI 3.0 description of the publicly accessible, read-only Borealis (Canadian Dataverse Repository) endpoints used to query the University of Alberta research data collection (subtree \"ualberta\"). Borealis runs the open-source Dataverse software; the full machine-readable spec is published by the server at https://borealisdata.ca/openapi (OpenAPI 3.0.3, Dataverse API, v6.8.1-SP). This document captures only the public Search and Info operations confirmed live against the production host. API tokens (X-Dataverse-key header) are required only for account-scoped or write operations; public searching is open.\n\nContact Support:\n Name: API Evangelist",
      "type": "text/plain"
    }
  }
